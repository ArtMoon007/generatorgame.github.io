@page "/auth/login"
@model GeneratorGame.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Вход";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<div class="auth-wrap">
    <div class="auth-card">
        <div class="auth-logo">GEN<span class="accent">ERATOR</span></div>
        <div class="auth-sub">CHALLENGE · LEADERBOARD · SPEED</div>
        <div class="auth-tabs">
            <a href="/auth/login" class="auth-tab active">ВХОД</a>
            <a href="/auth/register" class="auth-tab">РЕГИСТРАЦИЯ</a>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="auth-error">@Model.ErrorMessage</div>
        }

        <form id="loginForm" method="post" action="/auth/login">
            <div class="field">
                <label>ЛОГИН ИЛИ ПОЧТА</label>
                <input name="login" placeholder="username or email" required autocomplete="username" />
            </div>
            <div class="field">
                <label>ПАРОЛЬ</label>
                <input name="password" type="password" placeholder="••••••••" required autocomplete="current-password" />
            </div>
            <label class="auth-remember">
                <input type="checkbox" name="rememberMe" value="true" checked />
                <span class="auth-remember-box"></span>
                <span class="auth-remember-text">Запомнить меня на 30 дней</span>
            </label>
            <button id="loginSubmit" type="submit" class="auth-main-btn">ВОЙТИ</button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var form = document.getElementById('loginForm');
            var btn = document.getElementById('loginSubmit');
            if (!form || !btn) return;

            btn.addEventListener('touchend', function (e) {
                e.preventDefault();
                if (form.requestSubmit) form.requestSubmit();
                else form.submit();
            }, { passive: false });
        })();
    </script>
}
