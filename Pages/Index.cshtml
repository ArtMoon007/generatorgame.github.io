        <a href="/auth/register" class="auth-main-btn" style="display:block;text-align:center;margin-bottom:10px;margin-top:16px;text-decoration:none">СОЗДАТЬ АККАУНТ</a>
        <div class="auth-divider"><span>уже есть аккаунт</span></div>
        <a href="/auth/login" class="auth-sec-btn">ВОЙТИ</a>
