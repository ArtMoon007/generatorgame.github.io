@model string
@{
    var active = Model ?? "";
}
<div class="generator-tabs">
    <a href="/generators/bitebynight" class="generator-tab @(active == "bitebynight" ? "active" : "")">BITE BY NIGHT</a>
    <a href="/generators/forsaken" class="generator-tab @(active == "forsaken" ? "active" : "")">FORSAKEN</a>
    <a href="/generators/vip" class="generator-tab vip-tab @(active == "vip" ? "active" : "")">VIP GENERATOR</a>
    <a href="/pvp" class="generator-tab pvp-tab @(active == "pvp" ? "active" : "")">PVP</a>
</div>
