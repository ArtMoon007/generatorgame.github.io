@using Microsoft.AspNetCore.Http
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <title>@ViewData["Title"] - GENERATOR</title>
    <link rel="icon" type="image/x-icon" href="~/favicon.ico?v=2" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png?v=2" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png?v=2" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png?v=2" />
    <link rel="manifest" href="~/site.webmanifest?v=2" />
    <meta name="theme-color" content="#0b0b0b" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4743364872844858"
            crossorigin="anonymous"></script>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
@{
    var isEmbedded = Context.Request.Query["embedded"] == "1";
}
<body class="@(isEmbedded ? "pvp-embedded" : "")">
    <nav class="navbar">
        <div class="nav-brand">
            <div class="nav-logo">GEN<span class="accent">ERATOR</span></div>
            <button class="online-badge" id="onlineBadge" type="button" title="РџРѕРєР°Р·Р°С‚СЊ РІРёР·РёС‚С‹">
                <span class="online-dot"></span>
                <span id="onlineCount">0</span>
                <span id="onlineLabel">РѕРЅР»Р°Р№РЅ</span>
            </button>
        </div>
        <div class="nav-right">
            @{
                var _uid = Context.Session.GetInt32("UserId");
                var _name = Context.Session.GetString("UserName") ?? "";
                var _av = Context.Session.GetString("UserAvatar") ?? "";
            }
            @if (_uid != null)
            {
                <div class="nav-user">
                    @if (!string.IsNullOrEmpty(_av))
                    {
                        <img src="@_av" class="nav-avatar" alt="" />
                    }
                    else
                    {
                        <div class="nav-avatar-ph">@(_name.Length > 0 ? _name[0].ToString().ToUpper() : "?")</div>
                    }
                    <span class="nav-name">@_name</span>
                </div>
                <a href="/profile" class="nav-btn">ПРОФИЛЬ</a>
                <a href="/auth/logout" class="nav-btn">ВЫЙТИ</a>
            }
            else
            {
                <a href="/auth/login" class="nav-btn">ВОЙТИ</a>
            }
        </div>
    </nav>
    @RenderBody()
    <footer class="site-footer">
        <div class="site-footer-title">Автор игры и сайта</div>
        <div class="site-footer-links">
            <a href="https://t.me/ArJo_Team" target="_blank" rel="noopener" aria-label="Telegram ArJo Team" title="Telegram">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M21.8 4.4 18.5 20c-.2 1-1 1.2-1.8.7l-5-3.7-2.4 2.3c-.3.3-.5.5-1 .5l.4-5 9.1-8.2c.4-.4-.1-.6-.6-.2L5.9 13.5 1 12c-1-.3-1-1 .2-1.5L20.1 3.2c.9-.3 1.7.2 1.7 1.2z" />
                </svg>
            </a>
            <a href="https://www.youtube.com/@@ArJoPlay" target="_blank" rel="noopener" aria-label="YouTube ArJoPlay" title="YouTube">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M21.6 7.2s-.2-1.6-.9-2.3c-.9-.9-1.9-.9-2.4-1C15 3.6 12 3.6 12 3.6s-3 0-6.3.3c-.5.1-1.5.1-2.4 1-.7.7-.9 2.3-.9 2.3S2.2 9.1 2.2 11v1.8c0 1.9.2 3.8.2 3.8s.2 1.6.9 2.3c.9.9 2.1.9 2.6 1 1.9.2 6.1.3 6.1.3s3 0 6.3-.3c.5-.1 1.5-.1 2.4-1 .7-.7.9-2.3.9-2.3s.2-1.9.2-3.8V11c0-1.9-.2-3.8-.2-3.8zM10.1 15.1V8.5l5.8 3.3-5.8 3.3z" />
                </svg>
            </a>
            <a href="https://www.donationalerts.com/r/arjoplay" target="_blank" rel="noopener" class="donation-link" aria-label="Поддержать автора" title="Поддержать автора">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M12 21.4 10.6 20C5.6 15.5 2.3 12.5 2.3 8.8 2.3 5.8 4.6 3.5 7.6 3.5c1.7 0 3.3.8 4.4 2 1.1-1.2 2.7-2 4.4-2 3 0 5.3 2.3 5.3 5.3 0 3.7-3.3 6.7-8.3 11.2L12 21.4z" />
                </svg>
                <span>Поддержать автора</span>
            </a>
        </div>
    </footer>
    <script src="~/js/online.js?v=4"></script>
    <script src="~/js/ui-sounds.js?v=8"></script>
    <script src="~/js/player-level.js?v=2"></script>
    <script src="~/js/achievements.js?v=3"></script>
    <script src="~/js/pvp-invites.js?v=1"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

