@page "/profile"
@model GeneratorGame.Pages.ProfileModel
@{
    ViewData["Title"] = "Профиль";
    var profile = Model.View;
}

<main class="profile-page">
    <div class="profile-actions">
        <button type="button" class="profile-back-btn" onclick="if (history.length > 1) { history.back(); } else { location.href='/generators/bitebynight'; }">← НАЗАД</button>
        <a href="/generators/bitebynight">BITE BY NIGHT</a>
        <a href="/generators/forsaken">FORSAKEN</a>
    </div>

    <section class="profile-hero">
        <div class="profile-main">
            @if (!string.IsNullOrWhiteSpace(profile.AvatarUrl))
            {
                <img class="profile-avatar" src="@profile.AvatarUrl" alt="" />
            }
            else
            {
                <div class="profile-avatar profile-avatar-fallback">@profile.Username.FirstOrDefault().ToString().ToUpper()</div>
            }

            <div class="profile-title-block">
                <div class="profile-kicker">PLAYER PROFILE</div>
                <h1 class="@(profile.IsVip ? "is-vip-name" : "")">
                    @profile.Username
                    @if (profile.IsVip)
                    {
                        <span class="vip-name-badge">♛ VIP</span>
                    }
                </h1>
                <div class="profile-vip-row">
                    <a href="/vip" class="profile-vip-btn">@(profile.IsVip ? "VIP АКТИВЕН" : "КУПИТЬ VIP")</a>
                    @if (profile.IsVip)
                    {
                        <label class="profile-hide-toggle">
                            <input type="checkbox" id="hideStatsToggle" @(profile.HideStatsFromOthers ? "checked" : "") />
                            <span>Скрыть статистику</span>
                        </label>
                    }
                </div>
                <div class="profile-username-form">
                    <input id="profileUsernameInput" value="@profile.Username" maxlength="20" autocomplete="off" />
                    <button type="button" id="profileUsernameBtn">СМЕНИТЬ НИК</button>
                    <span id="profileUsernameStatus">
                        @if (profile.NextUsernameChangeAt.HasValue && profile.NextUsernameChangeAt.Value > DateTime.UtcNow)
                        {
                            @($"Доступно после {profile.NextUsernameChangeAt.Value.ToLocalTime():dd.MM.yyyy}")
                        }
                        else
                        {
                            @("Можно менять 1 раз в месяц")
                        }
                    </span>
                </div>
                <div class="profile-sound-settings">
                    <div>
                        <span>ЗВУК САЙТА</span>
                        <strong data-sound-value>70%</strong>
                    </div>
                    <input type="range" min="0" max="100" step="1" data-sound-volume aria-label="Громкость звука" />
                    <label>
                        <input type="checkbox" data-sound-muted />
                        <span>Выключить звук</span>
                    </label>
                </div>
                <div class="profile-level-row">
                    <span>LVL @profile.Level</span>
                    <span>@profile.Experience / @profile.NextLevelExperience XP</span>
                </div>
                <div class="profile-xp">
                    <div style="width:@profile.LevelProgress%"></div>
                </div>
            </div>
        </div>

        <div class="profile-rank">
            <span>ТЕКУЩИЙ ТОП</span>
            <strong>@(profile.Rank.HasValue ? $"#{profile.Rank.Value}" : "-")</strong>
        </div>
    </section>

    <section class="profile-stats">
        <div class="profile-stat"><span>Лучшее время</span><strong>@profile.BestTime</strong></div>
        <div class="profile-stat"><span>Среднее время</span><strong>@profile.AverageTime</strong></div>
        <div class="profile-stat"><span>Количество игр</span><strong>@profile.GamesPlayed</strong></div>
        <div class="profile-stat"><span>Любимый генератор</span><strong>@profile.FavoriteGenerator</strong></div>
        <div class="profile-stat"><span>Всего часов</span><strong>@profile.TotalHours.ToString("0.00")</strong></div>
    </section>

    <section class="profile-achievements-section">
        <div class="profile-section-head">
            <h2>Достижения</h2>
            <span>@profile.Achievements.Count(a => a.Unlocked) / @profile.Achievements.Count</span>
        </div>

        <div class="profile-achievements-grid">
            @foreach (var achievement in profile.Achievements)
            {
                <article class="profile-achievement @(achievement.Unlocked ? "is-unlocked" : "is-locked")">
                    <div class="profile-achievement-icon">@achievement.Icon</div>
                    <div>
                        <h3>@achievement.Title</h3>
                        <p>@achievement.Description</p>
                        <span>+@achievement.Experience XP</span>
                    </div>
                </article>
            }
        </div>
    </section>
</main>

@section Scripts {
    <script>
        const hideStatsToggle = document.getElementById('hideStatsToggle');
        if (hideStatsToggle) {
            hideStatsToggle.addEventListener('change', function () {
                fetch('/api/vip-settings', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ hideStats: hideStatsToggle.checked })
                }).catch(function () {});
            });
        }

        const usernameInput = document.getElementById('profileUsernameInput');
        const usernameButton = document.getElementById('profileUsernameBtn');
        const usernameStatus = document.getElementById('profileUsernameStatus');

        if (usernameInput && usernameButton && usernameStatus) {
            const setUsernameStatus = function (text, isError) {
                usernameStatus.textContent = text;
                usernameStatus.classList.toggle('is-error', !!isError);
            };

            usernameButton.addEventListener('click', async function () {
                const username = usernameInput.value.trim();
                if (!/^[a-zA-Z0-9_]{3,20}$/.test(username)) {
                    setUsernameStatus('Ник: 3-20 символов, латиница, цифры или _', true);
                    return;
                }

                usernameButton.disabled = true;
                setUsernameStatus('Проверяем ник...', false);

                try {
                    const response = await fetch('/api/profile-settings?handler=username', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ username })
                    });
                    const body = await response.json().catch(function () { return {}; });

                    if (!response.ok || body.error) {
                        setUsernameStatus(body.error || 'Не удалось сменить ник', true);
                        return;
                    }

                    setUsernameStatus('Ник изменен. Следующая смена через месяц.', false);
                    setTimeout(function () { window.location.reload(); }, 650);
                } catch {
                    setUsernameStatus('Сервер не ответил, попробуй еще раз', true);
                } finally {
                    usernameButton.disabled = false;
                }
            });

            usernameInput.addEventListener('keydown', function (event) {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    usernameButton.click();
                }
            });
        }
    </script>
}
