@page "/vip/success"
@{
    ViewData["Title"] = "Оплата успешна";
}

<main class="payment-result-page">
    <section class="payment-result-card is-success">
        <a class="payment-result-close" href="/generators/bitebynight" aria-label="Вернуться на главную">×</a>
        <div class="payment-result-icon">♛</div>
        <div class="payment-result-kicker">VIP АКТИВИРОВАН</div>
        <h1>Поздравляю, оплата успешна!</h1>
        <p>VIP PASS выдан на 30 дней. Если VIP уже был активен, срок продлён ещё на 30 дней.</p>
        <a class="payment-result-btn" href="/generators/bitebynight">ВЕРНУТЬСЯ В ИГРУ</a>
    </section>
</main>
