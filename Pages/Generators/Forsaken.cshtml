@page "/generators/forsaken"
@model GeneratorGame.Pages.Generators.ForsakenModel
@{
    ViewData["Title"] = "Forsaken";
    var userName = HttpContext.Session.GetString("UserName") ?? "";
}

<div class="generator-page">
    @await Html.PartialAsync("_GeneratorTabs", "forsaken")

    <div class="game-page">
        <div class="game-header">
            <div class="timer-lbl">GENERATOR</div>
            <div class="timer-display" id="timerDisplay" style="font-size:20px;letter-spacing:3px">00:00:000</div>
        </div>

        <div class="game-layout">
            <div class="left-col">
                <div class="lb-panel">
                    <div class="lb-header">
                        <span>LEADERBOARD</span>
                        <span>TOP 100</span>
                    </div>

                    <div class="lb-list" id="lbList">
                        <div class="lb-loading">загрузка...</div>
                    </div>

                    <div class="lb-my-row" id="myRow"></div>
                </div>
            </div>

            <div class="center-col">
                <div class="game-instruction fg-instruction">
                    <div>Соедини одинаковые точки линиями одного цвета.</div>
                    <div>Нельзя проводить линию через другие линии или чужие точки.</div>
                    <div>Пройди 4 слоя генератора как можно быстрее.</div>
                </div>

                <div class="game-stage-square" id="gameStageSquare">
                    <div class="fg-game">
                        <div class="fg-start-overlay" id="startBar" onclick="startGame()">
                            <div class="fg-start-title">FORSAKEN</div>
                            <div class="fg-start-sub">Нажми, чтобы играть</div>
                        </div>

                        <div class="fg-info">
                            <div>flows: <span id="fgFlows">0/0</span></div>
                            <div>moves: <span id="fgMoves">0</span></div>
                            <div>pipe: <span id="fgPipe">0%</span></div>
                        </div>

                        <div class="fg-board-wrap">
                            <svg id="fgSvg"></svg>
                            <div class="fg-board" id="fgBoard"></div>
                        </div>

                        <div class="fg-side-bar">
                            <div id="fgProgressFill"></div>
                        </div>

                        <div class="fg-layer" id="fgLayer">LAYER 1 / 4</div>

                        <div class="finish-overlay" id="finishOverlay" style="display:none">
                            <div class="finish-glow"></div>
                            <div class="finish-title">⚡ ГЕНЕРАТОР ЗАПУЩЕН</div>
                            <div class="finish-time" id="finishTime"></div>
                            <div class="finish-rank" id="finishRank"></div>
                            <button class="restart-btn" onclick="startGame()">ИГРАТЬ СНОВА</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="right-col">
                <div class="panel personal-panel right-personal-panel">
                    <div class="panel-title">МОИ ПОПЫТКИ</div>
                    <div class="pp-user" id="ppUser">—</div>
                    <div class="pp-best" id="ppBest">—</div>
                    <div class="pp-list" id="ppList"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const IS_LOGGED_IN = true;
        const CURRENT_USER = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(userName));
        const CURRENT_GENERATOR = "forsaken";
    </script>

    <script src="~/js/forsaken.js?v=6"></script>
}