@page "/vip"
@model GeneratorGame.Pages.VipModel
@{
    ViewData["Title"] = "VIP";
}

<main class="vip-page">
    <section class="vip-hero">
        <div class="vip-crown">♛</div>
        <div>
            <div class="vip-kicker">VIP СТАТУС</div>
            <h1>VIP PASS</h1>
            <p>75 руб / месяц</p>
        </div>
    </section>

    <section class="vip-benefits">
        <h2>Что даёт VIP?</h2>
        <div class="vip-benefit-list">
            <div><span>1</span>Анонимность от других игроков: можно скрыть статистику</div>
            <div><span>2</span>Пропуск всех реклам</div>
            <div><span>3</span>Уникальные значки и корона возле ника</div>
            <div><span>4</span>Поддержка автору игры</div>
            <div><span>5</span>Уникальный VIP GENERATOR</div>
            <div><span>6</span>Coming soon ...</div>
        </div>
    </section>

    <section class="vip-buy-box">
        <div>
            <strong>Покупка скоро будет доступна</strong>
            <span>Ссылка на оплату появится здесь позже.</span>
        </div>
        <button type="button" disabled>КУПИТЬ VIP</button>
    </section>

    <section class="vip-refund-box">
        <details>
            <summary>Политика возвратов</summary>
            <div class="vip-refund-content">
                <p>Пользователь может потребовать возврат денежных средств за товар при условии его неисправности по вине магазина или при невыдаче товара в сроки до 48 часов.</p>
                <p>Возврат денежных средств осуществляется на реквизиты пользователя, с которых производилась оплата.</p>
                <p>Возврат и замена товаров возможны только при условии неисправности самих товаров по вине магазина. Если пользователь передумал, не понравился товар и т.д., то возврат и замена не предусмотрены.</p>
                <p>Рассмотрение заявки пользователя осуществляется в течение 24 часов с момента обращения в поддержку магазина.</p>
                <p>В случае одобрения заявки возврат денежных средств осуществляется в течение 72 часов с момента принятия решения о возврате.</p>
            </div>
        </details>
    </section>
</main>
